  "tweaks": [
    {
      "id": "example-gamebar-tips",
      "cat": "my-extras",
      "title": "Hide the Game Bar pop-up when games start",
      "desc": "Stops the Xbox Game Bar tip appearing when a game opens.",
      "benefit": "No pop-up stealing focus as the game loads.",
      "impact": 1, "risk": "safe", "profile": 1,
      "actions": [
        { "kind": "reg", "root": "HKCU", "path": "Software\\Microsoft\\GameBar", "name": "ShowStartupPanel", "type": "DWORD", "num": 0 }
      ]
    },
    {
      "id": "example-ecn-off",
      "cat": "my-extras",
      "title": "Turn off ECN",
      "desc": "Turns off Explicit Congestion Notification in Windows networking.",
      "benefit": "Some routers handle game traffic better without it.",
      "impact": 1, "risk": "moderate", "profile": 2,
      "actions": [
        { "kind": "cmd", "apply": "netsh int tcp set global ecncapability=disabled", "revert": "netsh int tcp set global ecncapability=default" }
      ]
    }
  ],

